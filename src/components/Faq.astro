---
import { COPY, type Pergunta, type Variante } from "../variantes";

const { v } = Astro.props as { v: Variante };
const BASE: Pergunta[] = [
  { p: "Como funciona o teste grátis?", r: "Você cria a conta no painel, conecta seu WhatsApp e coloca os lobs para atender. Assine quando quiser continuar." },
  { p: "Quanto custa?", r: "O plano Essencial custa R$ 96 por mês e o plano com IA, R$ 146 por mês. No anual, o Essencial sai em 12x de R$ 39,90 (ou R$ 386 no Pix) e o plano com IA, em 12x de R$ 59,90 (ou R$ 589 no Pix)." },
  { p: "Posso usar os lobs de dentro do Claude e do ChatGPT?", r: "Sim. O plugin do lobs conecta a sua conta ao Claude e ao ChatGPT, e você consulta conversas e leads e assume atendimentos sem sair deles." },
  { p: "Qual a diferença dos lobs para um chatbot comum?", r: "Chatbot segue um menu fixo. Os lobs são agentes de IA: entendem a conversa, decidem o que fazer e executam nas suas ferramentas. Eles agendam, geram proposta, cobram, ligam e fazem follow-up sem você montar fluxos." },
  { p: "Por que o nome lobs?", r: "Vem de lobby: defender um interesse. Os lobs defendem um só, o da sua empresa, e fazem isso às claras. O cliente sabe que está falando com o assistente da sua marca, nada é prometido fora das suas regras e cada conversa fica registrada no painel pra você conferir." },
  { p: "Os lobs também ligam?", r: "Sim. Além do WhatsApp, eles fazem e recebem ligações com voz natural: retornam um lead, confirmam um horário ou retomam quem sumiu, do jeito que alguém do seu time faria." },
  { p: "Com quais ferramentas eles se conectam?", r: "Google Agenda, Calendly, planilhas, CRMs como RD Station e HubSpot, Pix e gateways de pagamento, e-mail, Notion e qualquer sistema com API ou webhook. Se você usa, os lobs aprendem a usar." },
  { p: "E se eles não souberem responder?", r: "Eles avisam o cliente que vão chamar alguém do time e transferem a conversa com um resumo completo. Você também pode assumir qualquer conversa a qualquer momento." },
  { p: "Preciso trocar meu número de WhatsApp?", r: "Não. Você conecta o número que já usa, e seus clientes continuam falando com o mesmo contato." },
  { p: "Como funciona o follow-up automático?", r: "Você define o tempo, por exemplo 10 minutos sem resposta. Os lobs retomam a conversa com uma mensagem ou ligação natural, no contexto do que foi falado, e tenta de novo em intervalos que você escolhe." },
  { p: "Meus dados e os dos meus clientes estão seguros?", r: "Sim. As conversas são criptografadas em trânsito e em repouso, seguimos a LGPD e seus dados nunca são usados para treinar modelos de terceiros." },
];
const perguntas = [...COPY[v].faq.inicio, ...BASE];
---
<section id="faq" class="px-4 py-20 md:px-6 md:py-24"><div class="mx-auto max-w-[760px]"><h2 class="h-section text-center">Perguntas frequentes</h2><p class="mx-auto mt-3 max-w-[520px] text-center text-[16px] leading-[26px] text-muted">Tudo o que você precisa saber antes de colocar os lobs do seu lado.</p><div class="mt-10 border-t border-line">{perguntas.map((q) => <details class="group border-b border-line"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[16px] font-medium [&::-webkit-details-marker]:hidden">{q.p}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted transition-transform duration-200 group-open:rotate-45" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></summary><p class="-mt-1 pb-5 text-[15px] leading-[25px] text-muted">{q.r}</p></details>)}</div></div></section>
