---
import Wordmark from "./Wordmark.astro";
import { APP_URL, DEMO_WHATSAPP_URL } from "../site";
import { siWhatsapp } from "simple-icons";
import LobCycler from "./islands/LobCycler";
import LobsHero from "./islands/LobsHero";
---
<LobsHero client:load><div class="mx-auto flex max-w-[1100px] flex-col items-center text-center"><h1 class="flex text-[44px] leading-[1.02] font-medium tracking-[-0.035em] sm:text-[64px] md:text-[92px] flex-wrap items-center justify-center gap-x-[0.2em]"><span>Conheça</span><span class="-my-[0.13em] inline-block h-[1.22em] w-[1.2em] translate-y-[0.02em]"><LobCycler client:load uid="hero" class="animate-breathe size-full" /></span><span>os <Wordmark /></span></h1><p class="mt-5 max-w-[520px] text-[16px] leading-[26px] text-muted md:text-[18px] md:leading-[28px]">Agentes de IA para o WhatsApp do seu negócio. Atendem, agendam, cobram e fazem follow-up: de clínicas e imobiliárias a escolas, lojas e profissionais autônomos.</p><div class="mt-7 mx-auto flex w-full max-w-[340px] flex-col gap-2 sm:max-w-none sm:flex-row sm:items-center sm:justify-center sm:gap-3"><a href={APP_URL} class="btn-glossy inline-flex h-12 w-full items-center justify-center rounded-full px-7 text-[16px] sm:h-[52px] sm:w-auto sm:text-[17px]">Testar grátis</a><a href={DEMO_WHATSAPP_URL} class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border border-line bg-white px-6 text-[16px] whitespace-nowrap text-ink shadow-[0_1px_2px_rgba(11,27,46,0.05)] transition-[background-color,transform] duration-200 hover:bg-surface-2 active:scale-[0.98] sm:h-[52px] sm:w-auto sm:text-[17px]"><svg viewBox="0 0 24 24" class="size-5 text-[#25D366]" fill="currentColor" aria-hidden="true"><path d={siWhatsapp.path} /></svg>Conversar com os lobs</a><a href="#planos" class="inline-flex h-12 w-full items-center justify-center rounded-full border border-line bg-white px-6 text-[16px] whitespace-nowrap text-ink transition-colors hover:bg-surface-2 sm:h-[52px] sm:w-auto sm:border-0 sm:bg-transparent sm:px-3 sm:text-[17px] sm:underline sm:decoration-ink/30 sm:underline-offset-[5px] sm:hover:bg-transparent sm:hover:decoration-ink">Assinar<span class="ml-1 max-sm:hidden">→</span></a></div></div></LobsHero>
