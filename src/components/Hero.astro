---
import { APP_URL, DEMO_WHATSAPP_URL } from "../site";
import { siWhatsapp } from "simple-icons";
import LobCycler from "./islands/LobCycler";
import LobsHero from "./islands/LobsHero";
import { COPY, type Variante } from "../variantes";

const { v } = Astro.props as { v: Variante };
const h = COPY[v].hero;
const demo = h.secundario.href === "demo";
---
<LobsHero client:load><div class="mx-auto flex max-w-[1000px] flex-col items-center text-center"><span class="inline-flex items-center gap-2 rounded-full border border-line bg-white/80 py-1 pr-3.5 pl-1.5 text-[13px] text-muted shadow-[0_1px_2px_rgba(11,27,46,0.05)] sm:text-[14px]"><span class="inline-block h-[22px] w-[26px]"><LobCycler client:load uid="hero" class="size-full" /></span>{h.etiqueta}</span><h1 class="mt-4 max-w-[920px] text-[32px] leading-[1.08] font-medium tracking-[-0.03em] text-balance sm:text-[48px] md:text-[64px]">{h.titulo}</h1><p class="mt-4 max-w-[620px] text-[15px] leading-[23px] text-muted md:mt-5 md:text-[18px] md:leading-[28px]">{h.subtitulo}</p><div class="mt-6 mx-auto flex w-full max-w-[340px] flex-col gap-2 sm:max-w-none sm:flex-row sm:items-center sm:justify-center sm:gap-3 md:mt-7"><a href={APP_URL} class="btn-glossy inline-flex h-12 w-full items-center justify-center rounded-full px-7 text-[16px] sm:h-[52px] sm:w-auto sm:text-[17px]">{h.botao}</a><a href={demo ? DEMO_WHATSAPP_URL : h.secundario.href} class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border border-line bg-white px-6 text-[16px] whitespace-nowrap text-ink shadow-[0_1px_2px_rgba(11,27,46,0.05)] transition-[background-color,transform] duration-200 hover:bg-surface-2 active:scale-[0.98] sm:h-[52px] sm:w-auto sm:text-[17px]">{demo && <svg viewBox="0 0 24 24" class="size-5 text-[#25D366]" fill="currentColor" aria-hidden="true"><path d={siWhatsapp.path} /></svg>}{h.secundario.texto}</a></div><p class="mt-4 flex flex-wrap justify-center gap-x-4 gap-y-1 text-[12.5px] text-muted sm:text-[14px]">{h.micro.map((m) => <span class="inline-flex items-center gap-1"><svg viewBox="0 0 24 24" class="size-3.5 text-[#16a34a]" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>{m}</span>)}</p></div></LobsHero>
