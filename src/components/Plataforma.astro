---
import { getCopy, type Nicho, type Variante } from "../variantes";
const { v, nicho = "geral" } = Astro.props as { v: Variante; nicho?: Nicho };
const copy = getCopy(nicho, v);
const { painel } = copy;
const cs = copy.nicho?.painelCartoes;
import Helpdesk from "./islands/Helpdesk";
import Crm from "./islands/Crm";
import Campaigns from "./islands/Campaigns";
import Notifications from "./islands/Notifications";
---
<section id="plataforma" class="px-4 py-20 md:px-6 md:py-24"><div class="mx-auto max-w-[1100px]"><div class="mx-auto max-w-[760px] text-center"><h2 class="h-section">{painel.titulo}</h2><p class="mt-4 text-[16px] leading-[26px] text-ink/75 md:text-[18px] md:leading-[29px]">{painel.texto}</p></div><div class="mt-12 grid gap-4 md:grid-cols-2"><div class="flex flex-col rounded-3xl border border-line bg-surface p-6 pb-0 sm:p-8 sm:pb-0"><h3 class="text-[16px] leading-[26px] font-medium">{cs?.[0]?.titulo ?? "Help desk de todo o atendimento"}</h3><p class="text-[16px] leading-[26px] text-ink/75">{cs?.[0]?.texto ?? "Todas as conversas dos lobs em um só lugar. Veja o que eles responderam, o que já foi resolvido e assuma com um clique."}</p><div class="relative mt-6 h-[230px] overflow-hidden rounded-t-2xl sm:h-[330px] bg-[radial-gradient(90%_70%_at_0%_100%,#8CC8FA_0%,transparent_60%),radial-gradient(80%_70%_at_100%_0%,#D6F4FF_0%,transparent_60%),linear-gradient(160deg,#EAF6FF_0%,#BFE2FF_55%,#93CBF8_100%)]"><div class="absolute inset-x-4 top-7 sm:inset-x-7"><Helpdesk nicho={nicho} client:visible={{ rootMargin: `400px` }} /></div></div></div><div class="flex flex-col rounded-3xl border border-line bg-surface p-6 pb-0 sm:p-8 sm:pb-0"><h3 class="text-[16px] leading-[26px] font-medium">{cs?.[1]?.titulo ?? "CRM que se atualiza sozinho"}</h3><p class="text-[16px] leading-[26px] text-ink/75">{cs?.[1]?.texto ?? "Cada conversa vira um lead no funil. Os lobs qualificam, mudam de etapa e registram tudo, sem ninguém preencher planilha."}</p><div class="relative mt-6 h-[230px] overflow-hidden rounded-t-2xl sm:h-[330px] bg-[radial-gradient(90%_70%_at_0%_100%,#8CC8FA_0%,transparent_60%),radial-gradient(80%_70%_at_100%_0%,#D6F4FF_0%,transparent_60%),linear-gradient(160deg,#EAF6FF_0%,#BFE2FF_55%,#93CBF8_100%)]"><div class="absolute inset-x-4 top-7 sm:inset-x-7"><Crm client:visible={{ rootMargin: `400px` }} /></div></div></div><div class="flex flex-col rounded-3xl border border-line bg-surface p-6 sm:p-8"><h3 class="text-[16px] leading-[26px] font-medium">{cs?.[2]?.titulo ?? "Campanhas que viram conversa"}</h3><p class="text-[16px] leading-[26px] text-ink/75">{cs?.[2]?.texto ?? "Dispare campanhas no WhatsApp para a sua base. Quando o cliente responde, um lob assume a conversa na hora."}</p><div class="mt-6 flex min-h-[260px] flex-1 items-center justify-center"><Campaigns client:visible={{ rootMargin: `400px` }} /></div></div><div class="flex flex-col rounded-3xl border border-line bg-surface p-6 sm:p-8"><h3 class="text-[16px] leading-[26px] font-medium">{cs?.[3]?.titulo ?? "Eles te avisam quando importa"}</h3><p class="text-[16px] leading-[26px] text-ink/75">{cs?.[3]?.texto ?? "Lead quente, cliente pedindo um humano, resumo do dia: os lobs mandam direto no seu WhatsApp. Você não precisa ficar de olho no painel."}</p><div class="mt-6 flex min-h-[260px] flex-1 items-center justify-center"><Notifications client:visible={{ rootMargin: `400px` }} /></div></div></div></div></section>
