---
import { CADASTRO_URL, LOGIN_URL, DEMO_WHATSAPP_URL, DEMO_PRONTO } from "../site";
import { siWhatsapp } from "simple-icons";
import Wordmark from "./Wordmark.astro";
import Lob from "./islands/Lob";
---
<header class="sticky top-0 z-50 border-b border-transparent bg-bg/90 backdrop-blur-md"><nav class="mx-auto flex h-16 max-w-[1200px] items-center gap-2 px-4 sm:gap-8 md:h-[72px] md:px-6"><a href="/" class="flex items-center gap-2" aria-label="lobs"><Lob still uid="header" class="size-8" title="LOBS" /><Wordmark class="text-[22px] leading-none" /></a><ul class="hidden items-center gap-7 text-[15px] text-ink/85 lg:flex"><li><a href="#para-quem" class="flex items-center gap-1 transition-colors hover:text-ink">Para quem</a></li><li><a href="#plataforma" class="flex items-center gap-1 transition-colors hover:text-ink">Plataforma</a></li><li><a href="#passos" class="flex items-center gap-1 transition-colors hover:text-ink">Como funciona</a></li><li><a href="#conectados" class="flex items-center gap-1 transition-colors hover:text-ink">Os lobs</a></li><li><a href="#planos" class="flex items-center gap-1 transition-colors hover:text-ink">Planos</a></li><li><a href="#faq" class="flex items-center gap-1 transition-colors hover:text-ink">FAQ</a></li></ul><details class="group relative ml-auto lg:hidden"><summary class="flex h-10 cursor-pointer list-none items-center gap-1.5 rounded-full bg-surface-2 px-3.5 text-[14.5px] text-ink [&::-webkit-details-marker]:hidden">Menu<svg viewBox="0 0 24 24" class="size-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><ul class="absolute top-12 left-0 z-50 w-[220px] rounded-2xl border border-line bg-white p-2 text-[15px] shadow-[0_24px_50px_-20px_rgba(11,27,46,0.35)]"><li><a href="#para-quem" class="block rounded-xl px-3 py-2.5 hover:bg-surface-2" onclick="this.closest('details').removeAttribute('open')">Para quem</a></li><li><a href="#plataforma" class="block rounded-xl px-3 py-2.5 hover:bg-surface-2" onclick="this.closest('details').removeAttribute('open')">Plataforma</a></li><li><a href="#passos" class="block rounded-xl px-3 py-2.5 hover:bg-surface-2" onclick="this.closest('details').removeAttribute('open')">Como funciona</a></li><li><a href="#conectados" class="block rounded-xl px-3 py-2.5 hover:bg-surface-2" onclick="this.closest('details').removeAttribute('open')">Os lobs</a></li><li><a href="#planos" class="block rounded-xl px-3 py-2.5 hover:bg-surface-2" onclick="this.closest('details').removeAttribute('open')">Planos</a></li><li><a href="#faq" class="block rounded-xl px-3 py-2.5 hover:bg-surface-2" onclick="this.closest('details').removeAttribute('open')">FAQ</a></li></ul></details><div class="flex items-center gap-2 lg:ml-auto"><a href={LOGIN_URL} class="inline-flex items-center justify-center gap-2 rounded-full whitespace-nowrap h-10 px-[18px] text-[14.5px] bg-surface-2 text-ink transition-[background-color,transform] duration-200 hover:bg-[#dcebfb] active:scale-[0.98] max-sm:hidden">Entrar</a>{DEMO_PRONTO && <a href={DEMO_WHATSAPP_URL} target="_blank" rel="noopener" aria-label="Conversar com os lobs no WhatsApp" class="inline-flex items-center justify-center gap-1.5 rounded-full whitespace-nowrap h-10 w-10 border border-line bg-white text-[14.5px] text-ink transition-[background-color,transform] duration-200 hover:bg-surface-2 active:scale-[0.98] xl:w-auto xl:px-4"><svg viewBox="0 0 24 24" class="size-[18px] text-[#25D366]" fill="currentColor" aria-hidden="true"><path d={siWhatsapp.path} /></svg><span class="max-xl:hidden">Conversar</span></a>}<a href={CADASTRO_URL} class="inline-flex items-center justify-center gap-2 rounded-full whitespace-nowrap h-10 px-3.5 text-[14px] btn-glossy sm:px-[18px] sm:text-[14.5px] ">Testar grátis</a></div></nav><div aria-hidden="true" class="scroll-progress absolute inset-x-0 bottom-0 h-[2px] bg-[linear-gradient(90deg,#1F7DF5,#16B8A6,#FFB21F,#FF8A0F,#FF2E93)]"></div></header>
