---
import { APP_URL } from "../site";
import Wordmark from "./Wordmark.astro";
import Lob from "./islands/Lob";
---
<header class="sticky top-0 z-50 border-b border-transparent bg-bg/90 backdrop-blur-md"><nav class="mx-auto flex h-16 max-w-[1200px] items-center gap-8 px-4 md:h-[72px] md:px-6"><a href="/" class="flex items-center gap-2" aria-label="lobs"><Lob still uid="header" class="size-8" title="LOBS" /><Wordmark class="text-[22px] leading-none" /></a><ul class="hidden items-center gap-7 text-[15px] text-ink/85 lg:flex"><li><a href="#produto" class="flex items-center gap-1 transition-colors hover:text-ink">Produto<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-3.5 opacity-60" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></li><li><a href="#tarefas" class="flex items-center gap-1 transition-colors hover:text-ink">Soluções<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-3.5 opacity-60" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></li><li><a href="#plataforma" class="flex items-center gap-1 transition-colors hover:text-ink">Plataforma</a></li><li><a href="#faq" class="flex items-center gap-1 transition-colors hover:text-ink">FAQ</a></li></ul><div class="ml-auto flex items-center gap-2"><a href={APP_URL} class="inline-flex items-center justify-center gap-2 rounded-full whitespace-nowrap h-10 px-[18px] text-[14.5px] bg-surface-2 text-ink transition-[background-color,transform] duration-200 hover:bg-[#dcebfb] active:scale-[0.98] max-sm:hidden">Entrar</a><a href={APP_URL} class="inline-flex items-center justify-center gap-2 rounded-full whitespace-nowrap h-10 px-[18px] text-[14.5px] btn-glossy ">Começar agora</a></div></nav><div aria-hidden="true" class="scroll-progress absolute inset-x-0 bottom-0 h-[2px] bg-[linear-gradient(90deg,#1F7DF5,#16B8A6,#FFB21F,#FF8A0F,#FF2E93)]"></div></header>
