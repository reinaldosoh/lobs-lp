---
import { COPY, type Variante } from "../variantes";
const p = COPY[(Astro.props as { v: Variante }).v].planos;
import Planos from "./islands/Planos";
---
<section id="planos" class="px-4 py-20 md:px-6 md:py-24">
  <div class="mx-auto max-w-[1100px]">
    <div class="mx-auto max-w-[640px] text-center">
      <h2 class="h-section">{p.titulo}</h2>
      <p class="mt-4 text-[16px] leading-[26px] text-muted md:text-[18px] md:leading-[29px]">{p.subtitulo}</p>
    </div>
    <div class="mt-10"><Planos notaComIa={p.notaComIa} client:load /></div>
  </div>
</section>
