---
import Planos from "./islands/Planos";
---
<section id="planos" class="px-4 py-20 md:px-6 md:py-24">
  <div class="mx-auto max-w-[1100px]">
    <div class="mx-auto max-w-[640px] text-center">
      <h2 class="h-section">Comece de graça. Assine quando quiser.</h2>
      <p class="mt-4 text-[16px] leading-[26px] text-muted md:text-[18px] md:leading-[29px]">Teste os lobs na sua empresa e escolha o plano que cabe no seu momento.</p>
    </div>
    <div class="mt-10"><Planos client:visible={{ rootMargin: `400px` }} /></div>
  </div>
</section>
