---
import { COPY, type Variante } from "../variantes";
const { titulo } = COPY[(Astro.props as { v: Variante }).v].cta;
import { APP_URL, DEMO_WHATSAPP_URL, DEMO_PRONTO } from "../site";
import { siWhatsapp } from "simple-icons";
import LobCycler from "./islands/LobCycler";
---
<section class="relative overflow-hidden px-4 pt-24 md:px-6 md:pt-32"><div class="mx-auto flex max-w-[820px] flex-col items-center text-center"><h2 class="h-section reveal-blur text-balance">{titulo}</h2><p class="mt-5 text-[16px] leading-[26px] text-muted md:text-[18px] md:leading-[28px]">Uma turma que nunca deixa seu cliente sem resposta e sempre fala a favor da sua empresa.</p><div class="mt-8 mx-auto flex w-full max-w-[340px] flex-col gap-2 sm:max-w-none sm:flex-row sm:items-center sm:justify-center sm:gap-3"><a href={APP_URL} class="btn-glossy inline-flex h-12 w-full items-center justify-center rounded-full px-7 text-[16px] sm:h-[52px] sm:w-auto sm:text-[17px]">Testar grátis</a>{DEMO_PRONTO && <a href={DEMO_WHATSAPP_URL} class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border border-line bg-white px-6 text-[16px] whitespace-nowrap text-ink shadow-[0_1px_2px_rgba(11,27,46,0.05)] transition-[background-color,transform] duration-200 hover:bg-surface-2 active:scale-[0.98] sm:h-[52px] sm:w-auto sm:text-[17px]"><svg viewBox="0 0 24 24" class="size-5 text-[#25D366]" fill="currentColor" aria-hidden="true"><path d={siWhatsapp.path} /></svg>Conversar com os lobs</a>}<a href="#planos" class="inline-flex h-12 w-full items-center justify-center rounded-full border border-line bg-white px-6 text-[16px] whitespace-nowrap text-ink transition-colors hover:bg-surface-2 sm:h-[52px] sm:w-auto sm:border-0 sm:bg-transparent sm:px-3 sm:text-[17px] sm:underline sm:decoration-ink/30 sm:underline-offset-[5px] sm:hover:bg-transparent sm:hover:decoration-ink">Assinar<span class="ml-1 max-sm:hidden">→</span></a></div></div><div class="relative mt-6 h-[330px] md:mt-8 md:h-[580px]" aria-hidden="true"><LobCycler client:visible={{ rootMargin: `400px` }} uid="cta" outline strokeWidth={0.5} reach={700} interval={3000} class="absolute top-2 left-1/2 w-[420px] -translate-x-1/2 md:top-3 md:w-[760px]" /></div></section>
