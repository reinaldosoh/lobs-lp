h></svg>Suas regras de atendimento</li></ul></div><div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-36 bottom-0 overflow-hidden rounded-b-3xl"><LobCycler client:visible={{ rootMargin: `400px` }} uid="produto" reach={900} interval={3400} class="absolute -bottom-[105px] left-1/2 w-[360px] -translate-x-1/2 lg:bottom-0 lg:left-auto lg:-right-[5.5%] lg:w-[60%] lg:translate-x-0 lg:translate-y-[27.3%]" /></div></div></div></section>
