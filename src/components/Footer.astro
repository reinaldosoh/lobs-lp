---
import { siWhatsapp } from "simple-icons";
import { TERMS_URL, PRIVACY_URL, CONTACT_EMAIL, CONTACT_WHATSAPP, CONTACT_WHATSAPP_LABEL, COMPANY_NAME, COMPANY_CNPJ } from "../site";
import Wordmark from "./Wordmark.astro";
import Lob from "./islands/Lob";
---
<footer class="relative z-10 border-t border-line bg-bg px-4 py-8 md:px-6 md:py-10"><div class="mx-auto flex max-w-[1100px] flex-col items-center gap-5 text-center md:items-stretch md:text-left"><div class="flex flex-col items-center gap-4 md:flex-row md:justify-between"><a href="/" class="flex items-center gap-2"><Lob still uid="footer" class="size-8" title="LOBS" /><Wordmark class="text-[22px] leading-none" /></a><div class="flex flex-col items-center gap-2 text-[14px] text-muted md:flex-row md:gap-6"><a href={`mailto:${CONTACT_EMAIL}`} class="inline-flex items-center gap-1.5 transition-colors hover:text-ink"><svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>{CONTACT_EMAIL}</a><a href={`https://wa.me/${CONTACT_WHATSAPP}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 transition-colors hover:text-ink"><svg viewBox="0 0 24 24" class="size-4 text-[#25D366]" fill="currentColor" aria-hidden="true"><path d={siWhatsapp.path} /></svg>{CONTACT_WHATSAPP_LABEL}</a></div></div><div class="flex w-full flex-col items-center gap-2 border-t border-line pt-5 text-[12px] leading-5 text-muted sm:text-[13px] md:flex-row md:justify-between"><nav class="flex items-center gap-5"><a href={TERMS_URL} class="transition-colors hover:text-ink">Termos de uso</a><a href={PRIVACY_URL} class="transition-colors hover:text-ink">Privacidade</a></nav><p class="m-0">© 2026 lobs · {COMPANY_NAME}<br class="sm:hidden" /><span class="max-sm:hidden"> · </span>CNPJ {COMPANY_CNPJ}</p></div></div></footer>
