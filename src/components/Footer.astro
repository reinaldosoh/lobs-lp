---
import { TERMS_URL, PRIVACY_URL, APP_URL } from "../site";
import Wordmark from "./Wordmark.astro";
import Lob from "./islands/Lob";
---
<footer class="relative z-10 border-t border-line bg-bg px-4 py-14 md:px-6"><div class="mx-auto grid max-w-[1100px] gap-10 md:grid-cols-[1.2fr_2fr]"><div><a href="/" class="flex items-center gap-2"><Lob still uid="footer" class="size-8" title="LOBS" /><Wordmark class="text-[22px] leading-none" /></a><p class="mt-3 text-[13px] text-muted">© 2026 lobs</p></div><div class="grid grid-cols-2 gap-8 sm:grid-cols-3"><div><h4 class="text-[14px] font-medium">Produto</h4><ul class="mt-3 space-y-2 text-[14px] text-muted"><li><a href="#produto" class="transition-colors hover:text-ink">Como funciona</a></li><li><a href="#plataforma" class="transition-colors hover:text-ink">Plataforma</a></li><li><a href="#faq" class="transition-colors hover:text-ink">FAQ</a></li></ul></div><div><h4 class="text-[14px] font-medium">Acesso</h4><ul class="mt-3 space-y-2 text-[14px] text-muted"><li><a href={APP_URL} class="transition-colors hover:text-ink">Entrar</a></li></ul></div><div><h4 class="text-[14px] font-medium">Legal</h4><ul class="mt-3 space-y-2 text-[14px] text-muted"><li><a href={TERMS_URL} class="transition-colors hover:text-ink">Termos de uso</a></li><li><a href={PRIVACY_URL} class="transition-colors hover:text-ink">Privacidade</a></li></ul></div></div></div></footer>
