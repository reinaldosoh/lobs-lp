---
import { siWhatsapp } from "simple-icons";
import { TERMS_URL, PRIVACY_URL, CONTACT_EMAIL, CONTACT_WHATSAPP, COMPANY_NAME, COMPANY_CNPJ } from "../site";
import Wordmark from "./Wordmark.astro";
import Lob from "./islands/Lob";
---
<footer class="relative z-10 border-t border-line bg-bg px-4 py-6 md:px-6 md:py-10"><div class="mx-auto flex max-w-[1100px] flex-col gap-4"><div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3"><a href="/" class="flex items-center gap-2"><Lob still uid="footer" class="size-8" title="LOBS" /><Wordmark class="text-[22px] leading-none" /></a><nav class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[13px] text-muted sm:text-[14px]"><a href={`mailto:${CONTACT_EMAIL}`} class="transition-colors hover:text-ink">{CONTACT_EMAIL}</a>{CONTACT_WHATSAPP && <a href={`https://wa.me/${CONTACT_WHATSAPP}`} class="inline-flex items-center gap-1.5 transition-colors hover:text-ink"><svg viewBox="0 0 24 24" class="size-4 text-[#25D366]" fill="currentColor" aria-hidden="true"><path d={siWhatsapp.path} /></svg>WhatsApp</a>}<a href={TERMS_URL} class="transition-colors hover:text-ink">Termos de uso</a><a href={PRIVACY_URL} class="transition-colors hover:text-ink">Privacidade</a></nav></div><p class="m-0 text-[12px] leading-5 text-muted sm:text-[13px]">© 2026 lobs · {COMPANY_NAME} · CNPJ {COMPANY_CNPJ}</p></div></footer>
